# ============================================================
#  Multilingual AI Media Summarizer — Environment Configuration
# ============================================================
#
#  Copy this file to `.env` and fill in your values.
#  NEVER commit `.env` to version control.
# ============================================================

# ── Google Gemini API (Master Key) ─────────────────────────────────
# Obtain your key at: https://aistudio.google.com/app/apikey
# This key is securely used by the backend for all user requests.
GEMINI_API_KEY=your_master_gemini_api_key_here

# ── Model Selection ───────────────────────────────────────────
# Recommended: gemini-2.5-flash  (fast, multimodal, cost-effective)
# Alternatives: gemini-2.5-pro   (higher quality, slower)
#               gemini-2.0-flash  (older, but very stable)
GEMINI_MODEL=gemini-2.5-flash

# ── File Handling ─────────────────────────────────────────────
# Maximum media file size in MB accepted by the app UI
MAX_VIDEO_SIZE_MB=500

# Directory for temporary local file storage (auto-cleaned after processing)
TEMP_DIR=./tmp_uploads

# ── Output Settings ───────────────────────────────────────────
# Default target language for the summary (can be overridden in UI)
DEFAULT_LANGUAGE=English

# ── App Settings ─────────────────────────────────────────────
APP_TITLE=Multilingual AI Media Summarizer
APP_ICON=🎬
DEBUG=false
